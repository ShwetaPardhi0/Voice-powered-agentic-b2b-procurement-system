# ── LLM & Embedding Model Settings ─────────────────────────────────────────────
GOOGLE_API_KEY=your-google-gemini-api-key
MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
TEMPERATURE=0.0

# ── Relational Vector Database (PostgreSQL + pgvector) ─────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=procurement_ai
DB_USER=postgres
DB_PASSWORD=your-postgres-password

# ── Cache & Key-Value Store (Redis) ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Voice Pipeline Settings (Deepgram, ElevenLabs, LiveKit) ────────────────────
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en

ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=3AMU7jXQuQa3oRvRqUmb
ELEVENLABS_VOICE_NAME=Viraj

LIVEKIT_URL=wss://your-livekit-server-url
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ── Slack PO Approval Integration Settings ─────────────────────────────────────
# OAuth Bot User Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# Channel ID for PO approval cards (C...)
SLACK_CHANNEL_ID=C0123456789
# Signing secret for verifying Slack webhook requests
SLACK_SIGNING_SECRET=your-slack-signing-secret

# ── Manager Email Notification Settings (SMTP) ─────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MANAGER_EMAIL=manager@company.com

# ── Dashboard URL (used in Slack View PO button links) ─────────────────────────
DASHBOARD_BASE_URL=http://localhost:7000
